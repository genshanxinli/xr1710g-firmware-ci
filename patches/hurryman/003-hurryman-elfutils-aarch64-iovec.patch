From 12bbddbf1234ffe0772abcda6bbe4bcef12f7958 Mon Sep 17 00:00:00 2001
From: Jihong Min <hurryman2212@gmail.com>
Date: Sat, 1 Aug 2026 06:38:21 +0900
Subject: [PATCH] tools: elfutils: use libc iovec on AArch64 hosts

---
 .../patches/014-aarch64-use-sys-uio.patch     | 36 +++++++++++++++++++
 1 file changed, 36 insertions(+)
 create mode 100644 tools/elfutils/patches/014-aarch64-use-sys-uio.patch

diff --git a/tools/elfutils/patches/014-aarch64-use-sys-uio.patch b/tools/elfutils/patches/014-aarch64-use-sys-uio.patch
new file mode 100644
index 00000000000000..495e66fadb9959
--- /dev/null
+++ b/tools/elfutils/patches/014-aarch64-use-sys-uio.patch
@@ -0,0 +1,36 @@
+From: Jihong Min <hurryman2212@gmail.com>
+Date: Sat, 1 Aug 2026 06:38:21 +0900
+Subject: [PATCH] tools: elfutils: use libc iovec on AArch64 hosts
+
+The libc headers already provide struct iovec on AArch64 hosts.
+Including linux/uio.h as well causes a duplicate definition when
+building elfutils on Ubuntu ARM64 runners.
+
+Use sys/uio.h in both AArch64 register backends.
+
+Assisted-by: Codex:gpt-5.6
+Signed-off-by: Jihong Min <hurryman2212@gmail.com>
+---
+
+--- a/backends/aarch64_initreg.c
++++ b/backends/aarch64_initreg.c
+@@ -33,7 +33,7 @@
+ #include "system.h"
+ #include <assert.h>
+ #if defined(__aarch64__) && defined(__linux__)
+-# include <linux/uio.h>
++# include <sys/uio.h>
+ # include <sys/user.h>
+ # include <sys/ptrace.h>
+ # include <asm/ptrace.h>
+--- a/backends/arm_initreg.c
++++ b/backends/arm_initreg.c
+@@ -38,7 +38,7 @@
+ #endif
+ 
+ #ifdef __aarch64__
+-# include <linux/uio.h>
++# include <sys/uio.h>
+ # include <sys/user.h>
+ # include <sys/ptrace.h>
+ /* Deal with old glibc defining user_pt_regs instead of user_regs_struct.  */
