diff --git a/package/base-files/files/lib/preinit/82_config_generate b/package/base-files/files/lib/preinit/82_config_generate
--- a/package/base-files/files/lib/preinit/82_config_generate
+++ b/package/base-files/files/lib/preinit/82_config_generate
@@ -1,10 +1,26 @@
 do_config_generate() {
-	[ -f /etc/board.json ] || {
+	# XR1710G fix: board_detect can produce an empty/corrupt board.json during
+	# early preinit (NVMEM/env not ready), and the old `-f` gate then cements
+	# the broken file forever: `-f` passes for a 0-byte file, so wifi config
+	# (which reads board.json) silently fails on every boot.  Require a
+	# non-empty, JSON-valid board file, retry once, and only move the
+	# regenerated file into place when it actually validates.
+	board_ok() {
+		[ -s "$1" ] && json_load "$(cat "$1")" 2>/dev/null
+	}
+
+	[ -s /etc/board.json ] && json_load "$(cat /etc/board.json)" 2>/dev/null || {
 		# This allows /etc/board.d/* scripts to use values from the uboot environment
 		mkdir -p /tmp/.uci
 		[ -f /etc/uci-defaults/30_uboot-envtools ] && (. /etc/uci-defaults/30_uboot-envtools)
 
 		echo "- generating board file -"
-		/bin/board_detect /tmp/board.json
-		mv /tmp/board.json /etc/board.json
+		/bin/board_detect /tmp/board.json || /bin/board_detect /tmp/board.json
+		if board_ok /tmp/board.json; then
+			mv /tmp/board.json /etc/board.json
+		else
+			echo "board.json generation failed or invalid; keeping previous file" >&2
+			rm -f /tmp/board.json
+		fi
 
 		/bin/config_generate > /dev/null
 	}
 }
