From: genshanxinli <genshanxinli@users.noreply.github.com>
Subject: [PATCH] airoha: cpufreq: make AVS voltage boost idempotent (baseline-anchored)

The 941 boost reads the *current* DAC value and subtracts delta each time
a high OPP is entered. With 1200<->1400 MHz oscillation the DAC ratchets
down one step per cycle until the 0x80 clamp, leaving Vcore pinned at the
1150 mV ceiling (non-idempotent). Also RG_AVS_OUT_EN(0x2a0) bit0 was never
checked: if it is 0 all DAC writes are silent no-ops and the boost never
happens.

Fix:
- capture the raw DAC value once per boot as the baseline (register is
  volatile across power cycles);
- boost target is always baseline - delta (never current - delta), and
  downgrades to <=1200 MHz restore the baseline exactly;
- skip the write when the DAC already equals the target (no CHG churn);
- check/enable RG_AVS_OUT_EN bit0 inside the same protected region,
  warn once if it stays 0;
- call order in set_performance_state: raise voltage before raising
  frequency, lower frequency before lowering voltage (never high-freq +
  low-voltage; transient over-voltage on downgrade is safe).

Applies after 941 (same file airoha-cpu-pmdomain.c). Line numbers match
the OpenWrt kernel baseline that 941 anchors to.

--- a/drivers/pmdomain/mediatek/airoha-cpu-pmdomain.c
+++ b/drivers/pmdomain/mediatek/airoha-cpu-pmdomain.c
@@ -48,6 +48,10 @@ struct airoha_cpu_pmdomain_priv {
 	struct clk_hw hw;
 	struct generic_pm_domain pd;
 	bool use_smc;
+	u32 dac_baseline;		/* raw AVS DAC captured once per boot */
+	bool dac_baseline_valid;
+	bool avs_out_en_ok;		/* RG_AVS_OUT_EN bit0 confirmed set */
+	u32 last_freq_mhz;		/* last target freq for V/f ordering */
 	/* Direct PLL registers (used when use_smc = false) */
 	void __iomem *pll_base;
 	void __iomem *mcucfg;
@@ -217,44 +217,66 @@ static int airoha_cpu_pll_set_freq(struct airoha_cpu_pmdomain_priv *priv,
 	}
 
-/*
- * XR1710G: BL31 has no AVS SMC handler, so the direct-PLL path never
- * adjusts Vcore.  High OPPs (>= 1300 MHz) exceed the ATF design point
- * (500-1200 MHz) and panic without a voltage boost (bit63-flip IABT).
- * Raise Vcore before switching to such OPPs by lowering the AVS DAC.
- */
-static void airoha_cpu_avs_voltage(struct airoha_cpu_pmdomain_priv *priv,
-				   unsigned int freq_mhz)
-{
-	void __iomem *base = priv->pll_base;
-	unsigned long flags;
-	u32 val, dac, target, delta_lsb = 0;
-
-	if (freq_mhz >= 1400)
-		delta_lsb = 29;	/* ~ +40 mV */
-	else if (freq_mhz >= 1300)
-		delta_lsb = 21;	/* ~ +30 mV */
-
-	local_irq_save(flags);
-
-	/* Unlock PLL/AVS registers */
-	val = readl(base + PLLRG_PROTECT);
-	writel((val & ~PLLRG_PROTECT_MASK) | PLLRG_PROTECT_KEY,
-	       base + PLLRG_PROTECT);
-
-	dac = readl(base + CPUPLL_AVS_DAC) & CPUPLL_AVS_DAC_MASK;
-	if (delta_lsb) {
-		target = dac - delta_lsb;
-		if (target < CPUPLL_AVS_DAC_MIN)
-			target = CPUPLL_AVS_DAC_MIN;
-		/* write new DAC value and toggle CHG to latch it */
-		writel(target | CPUPLL_AVS_DAC_CHG, base + CPUPLL_AVS_DAC);
-		writel(target, base + CPUPLL_AVS_DAC);
-		udelay(10);
-	}
-
-	/* Re-lock registers */
-	val = readl(base + PLLRG_PROTECT);
-	writel(val & ~PLLRG_PROTECT_MASK, base + PLLRG_PROTECT);
-
-	local_irq_restore(flags);
-}
+/*
+ * XR1710G: BL31 has no AVS SMC handler, so the direct-PLL path never
+ * adjusts Vcore.  High OPPs (>= 1300 MHz) exceed the ATF design point
+ * (500-1200 MHz) and panic without a voltage boost (bit63-flip IABT).
+ * Raise Vcore before switching to such OPPs by lowering the AVS DAC.
+ * Idempotent: boost target is anchored to the once-per-boot baseline,
+ * downgrades restore the baseline exactly (no ratchet), and
+ * RG_AVS_OUT_EN bit0 is verified once so a stuck-0 cannot silently
+ * neutralize the boost.
+ */
+static void airoha_cpu_avs_voltage(struct airoha_cpu_pmdomain_priv *priv,
+				   unsigned int freq_mhz)
+{
+	void __iomem *base = priv->pll_base;
+	unsigned long flags;
+	u32 val, dac, target, delta_lsb = 0;
+
+	if (freq_mhz >= 1400)
+		delta_lsb = 29;	/* ~ +40 mV */
+	else if (freq_mhz >= 1300)
+		delta_lsb = 21;	/* ~ +30 mV */
+
+	local_irq_save(flags);
+
+	/* Unlock PLL/AVS registers */
+	val = readl(base + PLLRG_PROTECT);
+	writel((val & ~PLLRG_PROTECT_MASK) | PLLRG_PROTECT_KEY,
+	       base + PLLRG_PROTECT);
+
+	/* 1) RG_AVS_OUT_EN bit0: verify/raise once; if stuck 0 all DAC
+	 * writes are silent no-ops and the boost never takes effect. */
+	if (!priv->avs_out_en_ok) {
+		val = readl(base + CPUPLL_AVS_OUT_EN);
+		if (!(val & BIT(0))) {
+			writel(val | BIT(0), base + CPUPLL_AVS_OUT_EN);
+			val = readl(base + CPUPLL_AVS_OUT_EN);
+		}
+		if (val & BIT(0))
+			priv->avs_out_en_ok = true;
+		else
+			pr_warn_once("airoha-cpu: AVS_OUT_EN(0x2a0) bit0 stuck 0\n");
+	}
+
+	/* 2) baseline: capture the raw register value once per boot */
+	if (!priv->dac_baseline_valid) {
+		dac = readl(base + CPUPLL_AVS_DAC) & CPUPLL_AVS_DAC_MASK;
+		if (dac < CPUPLL_AVS_DAC_MIN || dac > CPUPLL_AVS_DAC_MAX)
+			pr_warn_once("airoha-cpu: AVS DAC 0x%x out of range\n",
+				     dac);
+		priv->dac_baseline = dac;
+		priv->dac_baseline_valid = true;
+	}
+
+	/* 3) idempotent target: anchored to the baseline, never to the
+	 * current value; downgrades to <=1200 MHz restore it exactly. */
+	if (delta_lsb)
+		target = clamp(priv->dac_baseline - delta_lsb,
+			       CPUPLL_AVS_DAC_MIN, CPUPLL_AVS_DAC_MAX);
+	else
+		target = priv->dac_baseline;
+
+	dac = readl(base + CPUPLL_AVS_DAC) & CPUPLL_AVS_DAC_MASK;
+	if (dac != target) {
+		/* write new DAC value and toggle CHG to latch it */
+		writel(target | CPUPLL_AVS_DAC_CHG, base + CPUPLL_AVS_DAC);
+		writel(target, base + CPUPLL_AVS_DAC);
+		udelay(10);
+	}
+
+	/* Re-lock registers */
+	val = readl(base + PLLRG_PROTECT);
+	writel(val & ~PLLRG_PROTECT_MASK, base + PLLRG_PROTECT);
+
+	local_irq_restore(flags);
+}
 
 static int airoha_cpu_pmdomain_set_performance_state(
 		struct generic_pm_domain *domain, unsigned int state)
 {
 	struct airoha_cpu_pmdomain_priv *priv =
 		container_of(domain, struct airoha_cpu_pmdomain_priv, pd);
+	unsigned int freq_mhz;
+	int ret;
 
 	if (priv->use_smc)
 		return airoha_cpu_smc_set_freq(state);
 
-	airoha_cpu_avs_voltage(priv, 700 + state * 50);
-
-	return airoha_cpu_pll_set_freq(priv, state);
+	freq_mhz = 700 + state * 50;
+	if (freq_mhz >= priv->last_freq_mhz) {
+		airoha_cpu_avs_voltage(priv, freq_mhz);
+		ret = airoha_cpu_pll_set_freq(priv, state);
+	} else {
+		ret = airoha_cpu_pll_set_freq(priv, state);
+		airoha_cpu_avs_voltage(priv, freq_mhz);
+	}
+	priv->last_freq_mhz = freq_mhz;
+
+	return ret;
 }
 
