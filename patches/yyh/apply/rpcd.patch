+# Run a hardware probe behind a wall-clock deadline. The command itself runs
+# below two disposable shells, so killing those shells never waits for a
+# devmem/debugfs reader that is stuck in uninterruptible sleep.
+_run_with_deadline() {
+	local seconds="$1"
+	local tag="$2"
+	local base="/tmp/luci-airoha-npu.${tag}.$$"
+	local output="${base}.out"
+	local done="${base}.done"
+	local child_file="${base}.child"
+	local worker timer child rc elapsed
+	shift 2
+
+	[ -e "$HARDWARE_BLOCKED_FILE" ] && return 125
+	rm -f "$output" "$done" "$child_file"
+
+	(
+		HARDWARE_DEADLINE_ACTIVE=1
+		"$@" >"$output" 2>/dev/null &
+		child=$!
+		printf '%s\n' "$child" >"$child_file"
+		wait "$child"
+		printf '%s\n' "$?" >"$done"
+	) >/dev/null 2>&1 &
+	worker=$!
+
+	sleep "$seconds" >/dev/null 2>&1 &
+	timer=$!
+
+	# Current OpenWrt ash supports wait -n. If an older shell rejects it,
+	# both jobs remain alive and the coarse polling fallback is used.
+	wait -n 2>/dev/null
+	if kill -0 "$worker" 2>/dev/null && kill -0 "$timer" 2>/dev/null; then
+		elapsed=0
+		while [ "$elapsed" -lt "$seconds" ] && [ ! -e "$done" ]; do
+			sleep 1
+			elapsed=$((elapsed + 1))
+		done
+	fi
+
+	if [ -e "$done" ]; then
+		kill "$timer" 2>/dev/null
+		wait "$timer" 2>/dev/null
+		wait "$worker" 2>/dev/null
+		read -r rc <"$done" 2>/dev/null
