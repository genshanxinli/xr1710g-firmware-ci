+		if [ "${rc:-1}" -eq 0 ] && [ -s "$output" ]; then
+			cat "$output"
+			rm -f "$output" "$done" "$child_file"
+			return 0
+		fi
+
+		rm -f "$output" "$done" "$child_file"
+		return 1
+	fi
+
+	if [ -s "$child_file" ]; then
+		read -r child <"$child_file" 2>/dev/null
+		case "$child" in
+			*[!0-9]*|'') ;;
+			*) kill -9 "$child" 2>/dev/null ;;
+		esac
+	fi
