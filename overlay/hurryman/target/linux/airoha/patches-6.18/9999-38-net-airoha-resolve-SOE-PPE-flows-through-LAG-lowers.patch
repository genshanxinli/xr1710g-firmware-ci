From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jihong Min <hurryman2212@gmail.com>
Date: Tue, 4 Aug 2026 16:29:39 +0900
Subject: [PATCH] net: airoha: resolve SOE PPE flows through LAG lowers

Resolve SOE PPE flow endpoints through the selected LAG lower device.

Assisted-by: Codex:gpt-5.6
Signed-off-by: Jihong Min <hurryman2212@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_ppe.c | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
index 1f5d44d905e9..92f003a4859a 100644
@@ -42,6 +42,7 @@
 	struct airoha_soe_ppe_info state;
 	u32 tunnel_mtu;
 	bool input;
+	bool gdm4_return;
 };
 
 static const struct rhashtable_params airoha_flow_table_params = {
@@ -740,6 +741,7 @@
 static int
 airoha_ppe_soe_flow_add(struct airoha_eth *eth,
 			const struct flow_offload_tuple *tuple,
+			struct net_device *lower_dev,
 			struct airoha_flow_table_entry *e,
 			struct airoha_ppe_soe_info *info,
 			const struct flow_action_entry *xfrm_act)
@@ -771,12 +773,14 @@
 	if (tuple->l3proto != NFPROTO_IPV4 || x->props.family != AF_INET)
 		return -EOPNOTSUPP;
 
-	err = airoha_soe_ppe_flow_add(eth->soe, x, dir,
+	err = airoha_soe_ppe_flow_add(eth->soe, x, lower_dev, dir,
 				      &e->soe_flow, &info->state);
 	if (err)
 		return err;
 
 	info->input = dir == XFRM_DEV_OFFLOAD_IN;
+	info->gdm4_return = info->input && (netif_is_lag_port(lower_dev) ||
+					    netif_is_lag_master(lower_dev));
 	info->tunnel_mtu = tuple->mtu ? tuple->mtu :
 					      AIROHA_PPE_SOE_DEFAULT_TUNNEL_MTU;
 
@@ -2032,9 +2036,16 @@
 	entry.ipv4.data = e->data.ipv4.data;
 	memcpy(&entry.ipv4.l2, &e->data.ipv4.l2,
 	       sizeof(entry.ipv4.l2));
-	if (FIELD_GET(AIROHA_FOE_IB2_PSE_PORT, entry.ipv4.ib2) ==
-	    FE_PSE_PORT_GDM4)
+	if (info->gdm4_return ||
+	    FIELD_GET(AIROHA_FOE_IB2_PSE_PORT, entry.ipv4.ib2) ==
+		    FE_PSE_PORT_GDM4) {
 		entry.ipv4.l2.common.etype = AIROHA_PPE_SOE_MAGIC_GDM4;
+		entry.ipv4.data &= ~AIROHA_FOE_CHANNEL;
+		entry.ipv4.ib2 &= ~AIROHA_FOE_IB2_PSE_PORT;
+		entry.ipv4.ib2 |=
+			FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT, FE_PSE_PORT_GDM4) |
+			AIROHA_FOE_IB2_FAST_PATH;
+	}
 	if (FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, entry.ib1) ==
 	    PPE_PKT_TYPE_IPV4_HNAPT)
 		memcpy(&entry.ipv4.new_tuple, &entry.ipv4.orig_tuple,
@@ -2445,7 +2456,7 @@
 	}
 	e->hash = 0xffff;
 	e->cookie = f->cookie;
-	soe_flow = airoha_ppe_soe_flow_add(eth, tuple, e, &soe_info,
+	soe_flow = airoha_ppe_soe_flow_add(eth, tuple, odev, e, &soe_info,
 					   xfrm_act);
 	if (soe_flow < 0) {
 		err = soe_flow;
