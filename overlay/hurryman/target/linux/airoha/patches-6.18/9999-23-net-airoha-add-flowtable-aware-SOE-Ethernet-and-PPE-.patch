+static bool
+airoha_ppe_foe_entry_matches_input_xfrm(const struct airoha_foe_entry *hwe,
+					const struct airoha_soe_ppe_info *info)
+{
+	const struct airoha_foe_ipv4_tuple *tuple = &hwe->ipv4.orig_tuple;
+	u32 state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
+	u32 type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+
+	if (state != AIROHA_FOE_STATE_UNBIND ||
+	    tuple->src_ip != be32_to_cpu(info->saddr) ||
+	    tuple->dest_ip != be32_to_cpu(info->daddr))
+		return false;
+
+	switch (type) {
+	case PPE_PKT_TYPE_IPV4_ROUTE:
+		/* PPE learns an inbound ESP 3-tuple with the SPI in the
+		 * protocol/ports word. Match the complete hardware key against
+		 * the XFRM state rather than interpreting it as an IP protocol.
+		 */
+		return !info->encap && tuple->ports == be32_to_cpu(info->spi);
+	case PPE_PKT_TYPE_IPV4_HNAPT:
+		return info->encap &&
