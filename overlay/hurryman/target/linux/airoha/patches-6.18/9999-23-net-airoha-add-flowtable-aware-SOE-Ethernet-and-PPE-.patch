 {
 	u8 ref_addr[ETH_ALEN] __aligned(2);
@@ -561,8 +685,147 @@ static void airoha_dev_lro_enable(struct airoha_gdm_dev *dev)
 	}
 }
 
+enum airoha_fe_ifc_table {
+	AIROHA_FE_IFC_TCAM,
+	AIROHA_FE_IFC_LUT1,
+	AIROHA_FE_IFC_ACTION,
+};
+
+enum airoha_fe_ifc_command {
+	AIROHA_FE_IFC_WRITE = 1,
+	AIROHA_FE_IFC_CLEAR,
+};
+
+static int airoha_fe_ifc_request(struct airoha_eth *eth, u32 id, u32 offset,
+				 enum airoha_fe_ifc_table table,
+				 enum airoha_fe_ifc_command command)
+{
+	u32 val;
+
+	val = FIELD_PREP(FE_IFC_CTRL_ID_MASK, id) |
+	      FIELD_PREP(FE_IFC_CTRL_OFFSET_MASK, offset) |
+	      FIELD_PREP(FE_IFC_CTRL_TABLE_MASK, table) |
+	      FIELD_PREP(FE_IFC_CTRL_CMD_MASK, command) |
+	      FE_IFC_CTRL_REQ_MASK;
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_CTRL, val);
+
+	return read_poll_timeout(airoha_fe_rr, val, val & FE_IFC_CTRL_ACK_MASK,
+				 USEC_PER_MSEC, 5 * USEC_PER_MSEC, false, eth,
+				 REG_FE_CSR_IFC_CTRL);
+}
+
+static int airoha_fe_ifc_setup_natt(struct airoha_eth *eth)
+{
+	static const u32 tcam_key[9] = {
+		[0] = FIELD_PREP_CONST(FE_IFC_TCAM_RULE_TYPE_MASK, 1) |
+		      FE_IFC_TCAM_IPV4_VALID_MASK,
+		[2] = FIELD_PREP_CONST(FE_IFC_TCAM_DPORT_MASK, 4500),
+		[4] = BIT(0) | BIT(1),
+		[7] = FIELD_PREP_CONST(FE_IFC_TCAM_IPV4_PROTOCOL_MASK,
+				       IPPROTO_UDP),
+	};
+	static const u32 tcam_mask[9] = {
+		[0] = FE_IFC_TCAM_RULE_TYPE_MASK | FE_IFC_TCAM_IPV4_VALID_MASK,
+		[2] = FE_IFC_TCAM_DPORT_MASK,
+		[4] = BIT(0) | BIT(1),
+		[7] = FE_IFC_TCAM_IPV4_PROTOCOL_MASK,
+	};
+	u32 val;
+	int err, i;
+
+	err = airoha_fe_ifc_request(eth, 0, 0, AIROHA_FE_IFC_TCAM,
+				    AIROHA_FE_IFC_CLEAR);
+	if (err)
+		return err;
+
+	err = airoha_fe_ifc_request(eth, 0, 0, AIROHA_FE_IFC_LUT1,
+				    AIROHA_FE_IFC_CLEAR);
+	if (err)
+		return err;
+
+	/* The table-wide clear command does not clear the action SRAM. Disable
+	 * every entry before enabling IFC because its reset contents are not
+	 * defined.
+	 */
+	for (i = 0; i < 4; i++)
+		airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(i), 0);
+
+	for (i = 0; i < FE_IFC_TCAM_NUM_ENTRIES; i++) {
+		err = airoha_fe_ifc_request(eth, i, 2, AIROHA_FE_IFC_ACTION,
+					    AIROHA_FE_IFC_WRITE);
+		if (err)
+			return err;
+	}
+
+	/* Match the complete four-byte RFC 3948 Non-ESP Marker. Each IFC UDF
+	 * covers two bytes, starting at the UDP payload.
+	 */
+	val = FIELD_PREP(FE_IFC_UDF0_BASE_MASK, 2) |
+	      FIELD_PREP(FE_IFC_UDF0_OFFSET_MASK, sizeof(struct udphdr)) |
+	      FIELD_PREP(FE_IFC_UDF1_BASE_MASK, 2) |
+	      FIELD_PREP(FE_IFC_UDF1_OFFSET_MASK,
+			 sizeof(struct udphdr) + sizeof(u16));
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_UDF(0), val);
+
+	for (i = 0; i < 2; i++) {
+		val = FIELD_PREP(FE_IFC_LUT1_MASK_MASK, U16_MAX);
+		airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(0), val);
+		val = FIELD_PREP(FE_IFC_LUT1_FIELD_MASK, 32 + i) |
+		      FE_IFC_LUT1_RULE_VALID_MASK;
+		if (i == 1)
+			val |= FE_IFC_LUT1_RULE_END_MASK;
+		airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(1), val);
+		err = airoha_fe_ifc_request(eth, i, 0, AIROHA_FE_IFC_LUT1,
+					    AIROHA_FE_IFC_WRITE);
+		if (err)
+			return err;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(tcam_key); i++) {
+		airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(0), tcam_key[i]);
+		airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(1), tcam_mask[i]);
+		err = airoha_fe_ifc_request(eth, 0, 8 - i, AIROHA_FE_IFC_TCAM,
+					    AIROHA_FE_IFC_WRITE);
+		if (err)
+			return err;
+	}
+
+	/* Clear the complete action before enabling force-CPU on RX ring 1. */
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(0), 0);
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(1), 0);
+	err = airoha_fe_ifc_request(eth, 0, 0, AIROHA_FE_IFC_ACTION,
+				    AIROHA_FE_IFC_WRITE);
+	if (err)
+		return err;
+
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(0), 0);
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(1), 0);
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(2),
+		     FIELD_PREP(FE_IFC_ACT_NBQ_MASK, 1));
+	err = airoha_fe_ifc_request(eth, 0, 1, AIROHA_FE_IFC_ACTION,
+				    AIROHA_FE_IFC_WRITE);
+	if (err)
+		return err;
+
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(1), 0);
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(2), 0);
+	val = FE_IFC_ACT_FORCE_CPU_MASK | FE_IFC_ACT_RULE_END_MASK |
+	      FE_IFC_ACT_RULE_EN_MASK;
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(0), val);
+	err = airoha_fe_ifc_request(eth, 0, 2, AIROHA_FE_IFC_ACTION,
+				    AIROHA_FE_IFC_WRITE);
+	if (err)
+		return err;
+
+	airoha_fe_set(eth, REG_FE_CSR_IFC_CFG, FE_IFC_EN_MASK);
+
+	return 0;
+}
+
