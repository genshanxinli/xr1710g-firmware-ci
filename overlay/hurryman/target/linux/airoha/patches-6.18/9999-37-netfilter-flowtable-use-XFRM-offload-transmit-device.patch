From 337f14917ac8304d8ad422a4d72fce08feca289b Mon Sep 17 00:00:00 2001
From: Jihong Min <hurryman2212@gmail.com>
Date: Wed, 29 Jul 2026 08:18:35 +0900
Subject: [PATCH 32/33] netfilter: flowtable: use XFRM offload transmit device

For XFRM flowtable routes, redirect to the lower device selected by
the offload owner instead of the upper route device. Reject routes
whose offload state has no usable transmit device.

Assisted-by: Codex:gpt-5.6
Signed-off-by: Jihong Min <hurryman2212@gmail.com>
---
 net/netfilter/nf_flow_table_offload.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/net/netfilter/nf_flow_table_offload.c b/net/netfilter/nf_flow_table_offload.c
index 28e2568503b8..4ce3d93bb94f 100644
--- a/net/netfilter/nf_flow_table_offload.c
+++ b/net/netfilter/nf_flow_table_offload.c
@@ -706,10 +706,13 @@ static int flow_offload_redirect(struct net *net,
 		break;
 	case FLOW_OFFLOAD_XMIT_XFRM: {
 		struct dst_entry *dst = flow_offload_xfrm_path(this_tuple);
+		struct xfrm_state *x = dst_xfrm(this_tuple->dst_cache);
 
-		if (!dst || !dst->dev)
+		if (!dst || !dst->dev || !x)
+			return -EOPNOTSUPP;
+		ifindex = xfrm_dev_state_xmit_ifindex(x);
+		if (!ifindex)
 			return -EOPNOTSUPP;
-		ifindex = dst->dev->ifindex;
 		break;
 	}
 	case FLOW_OFFLOAD_XMIT_NEIGH:
-- 
