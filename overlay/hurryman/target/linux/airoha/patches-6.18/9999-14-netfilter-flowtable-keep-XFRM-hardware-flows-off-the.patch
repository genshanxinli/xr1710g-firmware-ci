From fbc7c38e426df4e74975fc4935d08fec633dfb24 Mon Sep 17 00:00:00 2001
From: Jihong Min <hurryman2212@gmail.com>
Date: Wed, 29 Jul 2026 08:17:57 +0900
Subject: [PATCH 13/33] netfilter: flowtable: keep XFRM hardware flows off the
 software path

Tear down flows after policy generation changes and prevent tuples
owned by XFRM hardware offload from also traversing the software
flowtable fast path.

Assisted-by: Codex:gpt-5.6
Signed-off-by: Jihong Min <hurryman2212@gmail.com>
---
 net/netfilter/nf_flow_table_ip.c | 35 ++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/net/netfilter/nf_flow_table_ip.c b/net/netfilter/nf_flow_table_ip.c
index 0b78decce8a9..a2cf003ea37d 100644
--- a/net/netfilter/nf_flow_table_ip.c
+++ b/net/netfilter/nf_flow_table_ip.c
@@ -18,6 +18,7 @@
 #include <net/neighbour.h>
 #include <net/netfilter/nf_flow_table.h>
 #include <net/netfilter/nf_conntrack_acct.h>
+#include <net/xfrm.h>
 /* For layer 4 checksum field offset. */
 #include <linux/tcp.h>
 #include <linux/udp.h>
@@ -43,6 +44,30 @@ static int nf_flow_state_check(struct flow_offload *flow, int proto,
 	return 0;
 }
 
+static bool
+nf_flow_xfrm_policy_stale(struct flow_offload_tuple_rhash *tuplehash)
+{
+#if IS_ENABLED(CONFIG_XFRM)
+	struct flow_offload_tuple *tuple = &tuplehash->tuple;
+	struct flow_offload *flow;
+	int dir;
+
+	if (!tuple->xfrm_policy_genid)
+		return false;
+
+	dir = tuple->dir;
+	flow = container_of(tuplehash, struct flow_offload, tuplehash[dir]);
+	if (tuple->xfrm_policy_genid ==
+	    xfrm_policy_generation(nf_ct_net(flow->ct)))
+		return false;
+
+	flow_offload_teardown(flow);
+	return true;
+#else
+	return false;
+#endif
+}
+
 static void nf_flow_nat_ip_tcp(struct sk_buff *skb, unsigned int thoff,
 			       __be32 addr, __be32 new_addr)
 {
@@ -823,6 +848,11 @@ nf_flow_offload_ip_hook(void *priv, struct sk_buff *skb,
 	tuplehash = nf_flow_offload_lookup(&ctx, flow_table, skb);
 	if (!tuplehash)
 		return NF_ACCEPT;
+	if (nf_flow_xfrm_policy_stale(tuplehash))
+		return NF_ACCEPT;
+	if (tuplehash->tuple.xfrm_input ||
+	    tuplehash->tuple.xfrm_input_deferred)
+		return NF_ACCEPT;
 
 	ret = nf_flow_offload_forward(&ctx, flow_table, tuplehash, skb);
 	if (ret < 0)
@@ -1139,6 +1169,11 @@ nf_flow_offload_ipv6_hook(void *priv, struct sk_buff *skb,
 	tuplehash = nf_flow_offload_ipv6_lookup(&ctx, flow_table, skb);
 	if (tuplehash == NULL)
 		return NF_ACCEPT;
+	if (nf_flow_xfrm_policy_stale(tuplehash))
+		return NF_ACCEPT;
+	if (tuplehash->tuple.xfrm_input ||
+	    tuplehash->tuple.xfrm_input_deferred)
+		return NF_ACCEPT;
 
 	ret = nf_flow_offload_ipv6_forward(&ctx, flow_table, tuplehash, skb);
 	if (ret < 0)
