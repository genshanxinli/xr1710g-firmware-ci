From 9a1c62e3eb97885792ab2b810936635b07142c24 Mon Sep 17 00:00:00 2001
From: Jihong Min <hurryman2212@gmail.com>
Date: Wed, 29 Jul 2026 08:18:35 +0900
Subject: [PATCH 28/33] xfrm: clear lower-device state during offload teardown

Clear the lower-device callback, ownership, and hardware handle captured
by an upper offload owner when the device state is freed.

Assisted-by: Codex:gpt-5.6
Signed-off-by: Jihong Min <hurryman2212@gmail.com>
---
 net/xfrm/xfrm_state.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/net/xfrm/xfrm_state.c b/net/xfrm/xfrm_state.c
index 413d54e1579e..6c4fb89b4d2c 100644
--- a/net/xfrm/xfrm_state.c
+++ b/net/xfrm/xfrm_state.c
@@ -872,6 +872,9 @@ void xfrm_dev_state_free(struct xfrm_state *x)
 		hlist_del_init(&x->dev_gclist);
 	WRITE_ONCE(xso->dev, NULL);
 	WRITE_ONCE(xso->state_ops, NULL);
+	WRITE_ONCE(xso->real_dev, NULL);
+	WRITE_ONCE(xso->real_ops, NULL);
+	WRITE_ONCE(xso->offload_handle, 0);
 	xso->type = XFRM_DEV_OFFLOAD_UNSPECIFIED;
 	spin_unlock_bh(&xfrm_state_dev_gc_lock);
 	netdev_put(dev, &xso->dev_tracker);
-- 
2.53.0

